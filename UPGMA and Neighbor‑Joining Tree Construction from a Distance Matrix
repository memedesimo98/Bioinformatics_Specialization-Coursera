# Theory:
# We want to compute D(C1, C2) where:
#   C1 = {i, l}
#   C2 = {j, k}
#
# Formula (average linkage):
#   D(C1, C2) = (1 / (|C1| * |C2|)) * sum_{x in C1} sum_{y in C2} D[x, y]
#
# Step 1: List all pairwise distances between C1 and C2
#   D[i, j] = 20
#   D[i, k] =  9
#   D[l, j] = 11
#   D[l, k] =  8
#
# Step 2: Sum them
#   20 + 9 + 11 + 8 = 48
#
# Step 3: Divide by |C1| * |C2| = 2 * 2 = 4
#   48 / 4 = 12
#
# Therefore:
#   D(C1, C2) = 12

# Neighbor-joining matrix entry D* for j,l
#
# Step 1: Compute row sums
#   r_i = 20 + 9 + 11 = 40
#   r_j = 20 + 17 + 11 = 48
#   r_k =  9 + 17 +  8 = 34
#   r_l = 11 + 11 +  8 = 30
#
# Step 2: Recall the NJ formula for n = 4
#   D*_{j,l} = (n - 2) * d_{j,l} - r_j - r_l
#
# Step 3: Plug in values
#   (4 - 2) * 11 - 48 - 30
#   = 2 * 11 - 78
#   = 22 - 78
#   = -56
#
# Final Answer:
#   D*_{j,l} = -56


library(ape)

# functions

matrix_to_UPGMA_NJ_tree <- function(D,label_name = NULL,method = "UPGMA") {
  # --- Step 1: Convert to 'dist' object
  dist_obj <- as.dist(D)
  
  if (method == "UPGMA") {
  # --- Step 2: Perform UPGMA clustering
  hc <- hclust(dist_obj, method = "average")
  
  # --- Step 3: Convert to phylo tree
  tree_upgma <- as.phylo(hc)
  
  # --- Step 4: Plot the tree
  plot(tree_upgma, main = "UPGMA tree from D")
  edgelabels(round(tree_upgma$edge.length, 3), frame = "n", adj = c(0.5, -0.5))
  } else {
    tree_upgma <- nj(D)
    plot(tree_upgma, main = "NJ tree from D")
    edgelabels(round(tree_upgma$edge.length, 3), frame = "n", adj = c(0.5, -0.5))
  }
  # Build from-to-length data frame
  edge_df <- data.frame(
    from   = tree_upgma$edge[,1] - 1,
    to     = tree_upgma$edge[,2] - 1,
    length = format(round(tree_upgma$edge.length, 3), nsmall = 3)
  )
  
  final_edge_df <- edge_df
  edges_df_new_names <- colnames(edge_df)
  final_edge_df_from <- final_edge_df[,2]
  final_edge_df[,2] <- final_edge_df[,1]
  final_edge_df[,1] <- final_edge_df_from
  colnames(final_edge_df) <- edges_df_new_names
  final_edge_df <- rbind(edge_df,final_edge_df)
  
if (!is.null(label_name)) {
  label_reference <- c(as.character(0:(length(label_name)-1)))
  
  label_map <- setNames(label_name,label_reference)
  
  # Apply mapping only to matching nodes
  final_edge_df$from <- ifelse(
    as.character(final_edge_df$from) %in% names(label_map),
    label_map[as.character(final_edge_df$from)],
    as.character(final_edge_df$from)
  )
  
  final_edge_df$to <- ifelse(
    as.character(final_edge_df$to) %in% names(label_map),
    label_map[as.character(final_edge_df$to)],
    as.character(final_edge_df$to)
  )
  
}
  return(final_edge_df)
}
