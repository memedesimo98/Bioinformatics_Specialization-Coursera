spectrum <- as.integer(strsplit(spec_str, " ")[[1]])
m <- length(spectrum)

# --- Step 2: Define amino acid map ---
AA_map_2 <- list(
  X = list(Mass = 4),
  Z = list(Mass = 5)
  # For real use: add all 20 amino acids with their integer masses
)

# --- Step 3: Initialize DP arrays ---
dp <- rep(-Inf, m+1)   # dp[k] = best score at node (k-1)
prev <- rep(NA, m+1)
aa_used <- rep(NA, m+1)

dp[1] <- 0  # node 0 (source)

for (j in 1:m) {  # node j
  for (aa in names(AA_map_2)) {
    mass <- AA_map_2[[aa]]$Mass
    i <- j - mass
    if (i >= 0) {
      candidate <- dp[i+1] + spectrum[j]  # shift by +1
      if (candidate > dp[j+1]) {
        dp[j+1] <- candidate
        prev[j+1] <- i
        aa_used[j+1] <- aa
      }
    }
  }
}


# --- Step 5: Traceback from sink ---
peptide <- character()
j <- m
while (!is.na(prev[j+1]) && j > 0) {
  peptide <- c(aa_used[j+1], peptide)  # prepend amino acid
  j <- prev[j+1]
}
cat("Peptide:", paste(peptide, collapse=""), "\n")

