# local_alignment()

local_alignment <- function(v, w, score_matrix) {
  v <- unlist(strsplit(v, "")) 
  w <- unlist(strsplit(w, "")) 
  V <- length(v) 
  W <- length(w) 
  s <- matrix(0, nrow = V+1, ncol = W+1) 
  Backtrack <- matrix("", nrow = V+1, ncol = W+1) 
  # Initialize score matrix 
  s[ ,1] <- 0
  s[1, ] <- 0
  # Initialize Backtrack for boundaries 
  Backtrack[2:(V+1), 1] <- "d" 
  # First column: deletions from v 
  Backtrack[1, 2:(W+1)] <- "r" 
  # First row: insertions from w 
  for (i in 2:(V+1)) {
    for (j in 2:(W+1)) {
      # Compute all three scores
      diag_score <- s[i - 1, j - 1] + score_matrix[v[i - 1], w[j - 1]]
      up_score   <- s[i - 1, j] - 5  # fixed indel penalty
      left_score <- s[i, j - 1] - 5
      free_ride <- 0
      
      max_score <- max(diag_score, up_score, left_score,free_ride)
      s[i, j] <- max_score
      
      # Prefer diagonal > up > left (you can adjust priority here)
      if (diag_score == max_score) {
        Backtrack[i, j] <- "dr"
      } else if (up_score == max_score) {
        Backtrack[i, j] <- "d"
      } else if(left_score == max_score){ 
        Backtrack[i, j] <- "r"
      } else {
        Backtrack[i, j] <- "0"
      }
      
    } 
  }
  max_val <- max(s)
  end_pos <- which(s == max_val, arr.ind = TRUE)[1, ]
  i <- end_pos[1]
  j <- end_pos[2]
  alignment <- Local_Output_Alignment(Backtrack,v,w,i,j)
  return(list(Backtrack = Backtrack, matrix = s,End_score = max_val, Alignment = alignment) )
}

Local_Output_Alignment <- function(Backtrack, v, w, i, j) {
  if (Backtrack[i, j] == "0" || Backtrack[i, j] == "" || i == 1 && j == 1) {
    return(list(v_align = "", w_align = ""))
  }
  
  if (i > 1 && Backtrack[i, j] == "d") {
    res <- Local_Output_Alignment(Backtrack, v, w, i - 1, j)
    return(list(v_align = paste(res$v_align,v[i - 1],sep=""),
                w_align = paste( res$w_align,"-",sep="")))
  }
  
  if (j > 1 && Backtrack[i, j] == "r") {
    res <- Local_Output_Alignment(Backtrack, v, w, i, j - 1)
    return(list(v_align = paste( res$v_align,"-",sep=""),
                w_align = paste( res$w_align,w[j - 1],sep="")))
  }
  
  if (i > 1 && j > 1 && Backtrack[i, j] == "dr") {
    res <- Local_Output_Alignment(Backtrack, v, w, i - 1, j - 1)
    return(list(v_align = paste( res$v_align,v[i - 1],sep=""),
                w_align = paste( res$w_align,w[j - 1],sep="")))
  }
  if (Backtrack[i, j] == "0" || s[i, j] == 0) {
    return(list(v_align = "", w_align = ""))
  }
  
  return(list(v_align = "", w_align = ""))
}


