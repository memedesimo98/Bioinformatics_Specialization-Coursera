#####
### Title: Least‑Squares Phylogeny and Tree Reconstruction from Distance Matrices

**Input format:**  
- `D`: an \(n \times n\) symmetric distance matrix with zero diagonal.  
- `tree`: optional starting topology (an `ape::phylo` object).  
- `method`: `"NJ"` or `"UPGMA"` for initial tree construction.  
- `weights`: `"OLS"` (ordinary least squares) or `"FM"` (Fitch–Margoliash).  
- `search`: `"none"` or `"NNI"` for topology optimization.  
- `DF_ftl`: a data frame with columns `from`, `to`, `length` describing an edge list.  
- `tip_labels`: optional labels for the tips when reconstructing a tree from an edge list.

**Objective of the functions:**  
This module implements the **Least‑Squares Phylogeny** framework from *Bioinformatics IV*, enabling reconstruction and optimization of phylogenetic trees from pairwise distances.

- `least_squares_tree()`  
  Performs weighted least‑squares fitting of branch lengths to match a given distance matrix.  
  The algorithm:  
  1. Builds an initial topology using **Neighbor‑Joining** or **UPGMA**, unless a custom tree is provided.  
  2. Constructs the **path‑incidence matrix** \(A\), where each row corresponds to a pair of taxa and each column to an edge.  
  3. Solves the weighted least‑squares system  
     

\[
     \min_b \| W^{1/2}(Ab - d) \|^2
     \]

  
     using ridge‑stabilized normal equations.  
  4. Enforces non‑negative branch lengths if requested.  
  5. Optionally performs **NNI (Nearest‑Neighbor Interchange)** search to improve the topology.  
  6. Returns the optimized tree and its discrepancy score.

- `convert_into_tree()`  
  Converts a simple edge list (`from`, `to`, `length`) into a valid `phylo` object.  
  Features:  
  - Automatically identifies **tips** and **internal nodes** from degrees.  
  - Supports labeling tips using a provided distance matrix or custom labels.  
  - Performs structural checks (edge count, connectivity).  
  - Produces a tree compatible with `ape` functions.

**Output format:**  
- `least_squares_tree()` returns an object containing:  
  - `tree`: optimized `phylo` tree  
  - `discrepancy`: least‑squares error  
  - `method`, `weights`, `search`: metadata  
- `convert_into_tree()` returns a valid `phylo` object ready for plotting or LS optimization.

**Coursera module:** Bioinformatics IV — Distance‑Based Phylogeny, Least‑Squares Trees, and Topology Optimization
#####


least_squares_tree <- function(D,
                               tree = NULL,                # NEW: optional custom tree
                               method = c("NJ", "UPGMA"),
                               weights = c("OLS", "FM"),
                               search = c("none", "NNI"),
                               max_iter = 100,
                               tol = 1e-8,
                               nonnegative = TRUE,
                               verbose = FALSE) {
  method  <- match.arg(method)
  weights <- match.arg(weights)
  search  <- match.arg(search)
  
  # --- Validation ---
  if (!is.matrix(D)) stop("D must be a matrix")
  if (nrow(D) != ncol(D)) stop("D must be square")
  n <- nrow(D)
  if (any(abs(D - t(D)) > 1e-10)) stop("D must be symmetric")
  if (any(diag(D) != 0)) stop("Diagonal of D must be zero")
  if (is.null(rownames(D))) rownames(D) <- paste0("t", seq_len(n))
  tip_labels <- rownames(D)
  
  # --- Initial topology ---
  if (is.null(tree)) {
    tree <- switch(method,
                   NJ    = ape::nj(D),
                   UPGMA = ape::as.phylo(hclust(as.dist(D), method = "average"))
    )
  }
  tree$tip.label <- tip_labels
  
  # --- Helpers ---
  tip_pairs <- function(labels) {
    idx <- combn(seq_along(labels), 2)
    data.frame(i = idx[1,], j = idx[2,], stringsAsFactors = FALSE)
  }
  pairs <- tip_pairs(tree$tip.label)
  dvec  <- D[cbind(pairs$i, pairs$j)]
  
  # Weight vector
  wvec <- switch(weights,
                 OLS = rep(1.0, length(dvec)),
                 FM  = {
                   w <- 1 / (dvec^2)
                   w[!is.finite(w)] <- 0
                   w
                 }
  )
  
  # Build path-incidence design matrix
  build_design_matrix <- function(tree) {
    E <- nrow(tree$edge)
    g <- vector("list", max(tree$edge))
    for (e in seq_len(E)) {
      a <- tree$edge[e, 1]; b <- tree$edge[e, 2]
      g[[a]] <- c(g[[a]], b); g[[b]] <- c(g[[b]], a)
    }
    edge_on_path <- function(u, v) {
      parent <- integer(length(g)); parent[] <- NA_integer_
      queue <- u; parent[u] <- 0L
      while (length(queue) > 0 && is.na(parent[v])) {
        x <- queue[1]; queue <- queue[-1]
        for (y in g[[x]]) if (is.na(parent[y])) {
          parent[y] <- x; queue <- c(queue, y)
        }
      }
      path_nodes <- integer(0); cur <- v
      while (cur != 0L) { path_nodes <- c(path_nodes, cur); cur <- parent[cur] }
      path_nodes <- rev(path_nodes)
      on_edge <- integer(E)
      for (k in seq_len(length(path_nodes) - 1)) {
        a <- path_nodes[k]; b <- path_nodes[k + 1]
        idx <- which((tree$edge[,1] == a & tree$edge[,2] == b) |
                       (tree$edge[,1] == b & tree$edge[,2] == a))
        on_edge[idx] <- 1L
      }
      on_edge
    }
    A <- matrix(0, nrow = nrow(pairs), ncol = E)
    for (r in seq_len(nrow(pairs))) {
      u <- pairs$i[r]; v <- pairs$j[r]
      A[r, ] <- edge_on_path(u, v)
    }
    colnames(A) <- paste0("e", seq_len(E))
    A
  }
  
  # Weighted LS solve
  optimize_branch_lengths <- function(tree, dvec, wvec, nonnegative, tol) {
    A <- build_design_matrix(tree)
    Wsqrt <- sqrt(wvec)
    Aw <- A * Wsqrt
    dw <- dvec * Wsqrt
    XtX <- crossprod(Aw)
    Xty <- crossprod(Aw, dw)
    ridge <- 0
    if (qr(XtX)$rank < ncol(XtX)) ridge <- tol
    b <- tryCatch(solve(XtX + diag(ridge, ncol(XtX)), Xty),
                  error = function(e) MASS::ginv(XtX) %*% Xty)
    if (nonnegative) b <- pmax(as.numeric(b), 0)
    tree$edge.length <- b
    list(tree = tree, A = A, b = b)
  }
  
  discrepancy <- function(tree, D) {
    d_tree <- as.matrix(ape::cophenetic.phylo(tree))
    idx <- upper.tri(D, diag = FALSE)
    sum((d_tree[idx] - D[idx])^2)
  }
  
  # --- Initialize ---
  fit <- optimize_branch_lengths(tree, dvec, wvec, nonnegative, tol)
  tree <- fit$tree
  best_score <- discrepancy(tree, D)
  if (verbose) cat(sprintf("Initial discrepancy: %.6f\n", best_score))
  
  # --- Topology search ---
  if (search == "NNI" && max_iter > 0) {
    iter <- 0; improved <- TRUE
    while (improved && iter < max_iter) {
      iter <- iter + 1; improved <- FALSE
      nbrs <- ape::nni(tree)
      for (cand in nbrs) {
        cand$tip.label <- tip_labels
        fit_c <- optimize_branch_lengths(cand, dvec, wvec, nonnegative, tol)
        cand <- fit_c$tree
        score <- discrepancy(cand, D)
        if (score + tol < best_score) {
          tree <- cand; best_score <- score; improved <- TRUE
          if (verbose) cat(sprintf("Iter %d: improved to %.6f\n", iter, best_score))
        }
      }
    }
  }
  
  out <- list(tree = tree,
              discrepancy = best_score,
              method = method,
              weights = weights,
              search = search)
  class(out) <- "ls_phylo_fit"
  out
}

