#####
### Title: Sequence Reconstruction from Paired de Bruijn Graph Paths

**Input format:**  
- `paths`: a list where the first element (`paths[[1]]`) contains paired node labels in the form `"prefix,suffix"`, representing the Eulerian path or cycle through a paired de Bruijn graph.  
- `seq1`, `seq2`: intermediate strings reconstructed internally from the first and second components of each paired node.

**Objective of the functions:**  
- `find_overlap()` identifies the **longest prefix–suffix overlap** between two reconstructed strings.  
  This is used to merge the two sequences produced by paired‑read assembly.  
- `reconstruct_sequence()` rebuilds the final genome string by:  
  - extracting the first and second components of each paired node,  
  - reconstructing the two strings implied by the Eulerian traversal,  
  - detecting their maximal overlap,  
  - merging them into a single contiguous sequence.

**Output format:**  
- A single character string representing the **reconstructed genome** obtained from paired‑read de Bruijn graph traversal.

**Coursera module:** Bioinformatics II — Week 3 (Genome Assembly with Paired Reads)
#####

# Function to find the longest overlap
find_overlap <- function(seq1, seq2) {
  max_overlap <- 0
  overlap_seq <- ""
  
  for (i in 1:nchar(seq1)) {
    suffix <- substr(seq1, i, nchar(seq1))
    prefix <- substr(seq2, 1, nchar(suffix))
    
    if (suffix == prefix) {
      max_overlap <- nchar(suffix)
      overlap_seq <- suffix
      break
    }
  }
  
  return(overlap_seq)
}

# Function to reconstruct the final sequence
reconstruct_sequence <- function(paths) {
  first_seq <- c()
  second_seq <- c()
  
  for (entry in paths[[1]]) {
    parts <- strsplit(entry, ",")[[1]]
    first_seq <- c(first_seq, parts[1])
    second_seq <- c(second_seq, parts[2])
  }
  
  seq1 <- paste0(first_seq[1], paste(sapply(first_seq[-1], function(x) substr(x, nchar(x), nchar(x))), collapse = ""))
  seq2 <- paste0(second_seq[1], paste(sapply(second_seq[-1], function(x) substr(x, nchar(x), nchar(x))), collapse = ""))
  
  # Find the actual overlapping region
  overlap <- find_overlap(seq1, seq2)
  
  if (nchar(overlap) > 0) {
    seq2_trimmed <- substr(seq2, nchar(overlap) + 1, nchar(seq2))
    final_sequence <- paste0(seq1, seq2_trimmed)
  } else {
    final_sequence <- paste(seq1, seq2, sep = " ")
  }
  
  return(final_sequence)
}

reconstructed <- reconstruct_sequence(paths)
print(reconstructed)
