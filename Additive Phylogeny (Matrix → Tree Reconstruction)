# from matrix to tree nodes

compute_limb_length_On <- function(j, D, k = NULL) {
  n <- nrow(D)
  stopifnot(n == ncol(D))
  stopifnot(j >= 1 && j <= n)
  
  # pick any k != j if not provided
  if (is.null(k)) {
    k <- if (j != 1) 1 else 2
  }
  if (k == j) {
    k <- if (j != 1) 1 else 2
  }
  
  i_idx <- setdiff(seq_len(n), j)
  L <- (D[i_idx, j] + D[j, k] - D[i_idx, k]) / 2
  
  limb <- min(L)
  i_star <- i_idx[which.min(L)]
  
  list(limb = limb, sibling = i_star, k_used = k, L_by_i = setNames(L, i_idx))
}

additive_phylogeny_brick <- function(D) {
  n <- nrow(D)
  leaves_name <- colnames(D)
  remaining_leaves_name <- leaves_name
  bald_matrix <- D
  internal_node <- max(as.numeric(colnames(D)))
  internal_node_name <- as.character(internal_node)
  internal_node_number <- NA
  edges_df_new <- data.frame(from = character(), to = character(), length = numeric(), stringsAsFactors = FALSE)
  while (nrow(bald_matrix) > 2 && length(remaining_leaves_name) > 0) {
    
    x <- remaining_leaves_name[[1]]
    j <- match(x, colnames(bald_matrix))
    
    # compute degree of each node in current matrix
    deg <- rowSums(bald_matrix == min(bald_matrix)) # crude degree proxy
    
    cat("\n---\nConsidering node:", x, "at index", j, "\n")
    cat("Remaining leaves:", remaining_leaves_name, "\n")
    
    edges <- compute_limb_length_On(j, bald_matrix)
    cat("Computed limb length:", edges$limb, "using k =", edges$k_used, "\n")
    
    if (edges$limb > 0) {
      cat("-> Node", x, "is degree 1, processing with limb length\n")
      remaining_leaves_name <- remaining_leaves_name[-1]
      
      new_col <- bald_matrix[, j] - edges$limb
      new_row <- bald_matrix[j, ] - edges$limb
      zero_idx <- which(new_col[-j] == 0)
      
      if (length(zero_idx) > 0) {
        actual_idx <- setdiff(seq_along(new_col), j)[zero_idx]
        sibling_node_name <- colnames(bald_matrix)[actual_idx]
        cat("Sibling detected:", sibling_node_name, "\n")
        
        edges_df <- data.frame(
          from = x,
          to   = sibling_node_name,
          length = edges$limb,
          stringsAsFactors = FALSE
        )
      } else {
        internal_node <- internal_node + 1
        internal_node_name <- as.character(internal_node)
        cat("No sibling found, creating new internal node:", internal_node_name, "\n")
        
        new_col[[j]] <- new_row[[j]] <- edges$limb
        new_row <- c(new_row, 0) 
        
        column_names_bald <- colnames(bald_matrix)
        new_column_names_bald <- c(column_names_bald, internal_node_name)
        
        bald_matrix <- cbind(bald_matrix, new_col)
        bald_matrix <- rbind(bald_matrix, new_row)
        
        colnames(bald_matrix) <- rownames(bald_matrix) <- new_column_names_bald
        edges_df <- data.frame(from = x, to = internal_node_name, length = edges$limb, stringsAsFactors = FALSE)
        remaining_leaves_name <- c(remaining_leaves_name, internal_node_name)
      }
      
      bald_matrix <- bald_matrix[setdiff(colnames(bald_matrix), x),
                                 setdiff(colnames(bald_matrix), x)]
      cat("Removed node", x, "from matrix. New matrix size:", nrow(bald_matrix), "\n")
      
      internal_node_number <- match(internal_node_name, colnames(bald_matrix))
      edges_df_new <- rbind(edges_df_new, edges_df) 
      
    } else {
      cat("-> Node", x, "is NOT degree 1, rotating to end of queue\n")
      remaining_leaves_name <- c(remaining_leaves_name[-1], x)
    }
  }
  edges_df <- data.frame(from = colnames(bald_matrix)[1], to = colnames(bald_matrix)[2], length = bald_matrix[1,2],
                         stringsAsFactors = FALSE)
  edges_df_new <- rbind(edges_df_new,edges_df)
  
  final_edge_df <- edges_df_new
  edges_df_new_names <- colnames(edges_df_new)
  final_edge_df_from <- final_edge_df[,2]
  final_edge_df[,2] <- final_edge_df[,1]
  final_edge_df[,1] <- final_edge_df_from
  colnames(final_edge_df) <- edges_df_new_names
  final_edge_df <- rbind(edges_df_new,final_edge_df)
  return(final_edge_df)
}

