find_eulerian_cycle <- function(data) {
  # Parse the input data to build the graph
  graph <- list()
  for (entry in data) {
    parts <- strsplit(entry, ": ")[[1]]
    node <- as.numeric(parts[1])
    if (length(parts) > 1) {
      neighbors <- as.numeric(strsplit(parts[2], " ")[[1]])
    } else {
      neighbors <- numeric(0)
    }
    graph[[as.character(node)]] <- neighbors
  }
  
  # Initialize variables
  cycle <- character(0)
  stack <- c(names(graph)[1]) # Start at any node
  
  # Traverse the graph using Hierholzer's algorithm
  while (length(stack) > 0) {
    current <- stack[length(stack)]
    if (length(graph[[current]]) > 0) {
      # Follow an edge
      next_node <- graph[[current]][1]
      graph[[current]] <- graph[[current]][-1]
      stack <- c(stack, next_node)
    } else {
      # No more neighbors; add to cycle
      cycle <- c(cycle, current)
      stack <- stack[-length(stack)]
    }
  }
  
  # Reverse the cycle to get the correct order
  return(as.numeric(rev(cycle)))
}
find_eulerian_path <- function(data) {
  # Parse the input data to build the graph
  graph <- list()
  degrees <- list()
  
  for (entry in data) {
    parts <- strsplit(entry, ": ")[[1]]
    node <- as.numeric(parts[1])
    if (length(parts) > 1) {
      neighbors <- as.numeric(strsplit(parts[2], " ")[[1]])
    } else {
      neighbors <- numeric(0)
    }
    graph[[as.character(node)]] <- neighbors
    
    # Track node degrees
    if (!(as.character(node) %in% names(degrees))) {
      degrees[[as.character(node)]] <- 0
    }
    degrees[[as.character(node)]] <- degrees[[as.character(node)]] + length(neighbors)
    
    for (neighbor in neighbors) {
      if (!(as.character(neighbor) %in% names(degrees))) {
        degrees[[as.character(neighbor)]] <- 0
      }
      degrees[[as.character(neighbor)]] <- degrees[[as.character(neighbor)]] + 1
    }
  }
  
  # Find a valid starting node (an odd-degree node, or any node if none exist)
  start_node <- NULL
  for (node in names(degrees)) {
    if (degrees[[node]] %% 2 == 1) {
      start_node <- node
      break
    }
  }
  if (is.null(start_node)) {
    start_node <- names(graph)[1] # Default to any node
  }
  
  # Initialize variables
  path <- character(0)
  stack <- c(start_node)
  
  # Traverse the graph using Hierholzer's algorithm
  while (length(stack) > 0) {
    current <- stack[length(stack)]
    if (length(graph[[current]]) > 0) {
      next_node <- graph[[current]][1]
      graph[[current]] <- graph[[current]][-1]
      stack <- c(stack, next_node)
    } else {
      path <- c(path, current)
      stack <- stack[-length(stack)]
    }
  }
  
  # Reverse the path to get the correct order
  return(as.numeric(rev(path)))
}

